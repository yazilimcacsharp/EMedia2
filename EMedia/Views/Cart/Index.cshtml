@model EMedia.ViewModels.ShoppingCartViewModel

<div class="section">
	<!-- container -->
	<div class="container">
		<!-- row -->
		<div class="row">
			<form asp-action="AddressAndPayment" asp-controller="Checkout" method="post">

			
			<div class="col-md-5">
